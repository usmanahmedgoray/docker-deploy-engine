                    <tr><td><strong>Express v5</strong></td><td>HTTP API & view server</td><td>v5.x</td></tr>
                    <tr><td><strong>Dockerode</strong></td><td>Docker daemon socket client</td><td>v4</td></tr>
                    <tr><td><strong>EJS</strong></td><td>Server-side HTML templating</td><td>v3</td></tr>
                    <tr><td><strong>http-proxy-middleware</strong></td><td>Reverse proxy engine</td><td>v3</td></tr>
                    <tr><td><strong>swagger-ui-express</strong></td><td>OpenAPI documentation UI</td><td>latest</td></tr>
