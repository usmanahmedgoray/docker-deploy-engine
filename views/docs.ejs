                    <span class="page-nav-label">Previous</span>
                    <span class="page-nav-name">${prev.icon} ${prev.label}</span>
                </div>
            </div>
        `;
    } else {
        footer.innerHTML += `<div class="page-nav-spacer"></div>`;
    }

    if (next) {
        footer.innerHTML += `
            <div class="page-nav-card next" data-section="${next.id}" role="button">
                <div class="page-nav-text">
                    <span class="page-nav-label">Next</span>
                    <span class="page-nav-name">${next.icon} ${next.label}</span>
                </div>
                <div class="page-nav-arrow">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                </div>
            </div>
        `;
    }

    section.appendChild(footer);

    // Wire click events
    footer.querySelectorAll('.page-nav-card[data-section]').forEach(card => {
        card.addEventListener('click', () => {
            const targetId = card.dataset.section;
            const targetNavItem = document.querySelector(`.nav-item[data-section="${targetId}"]`);
            if (targetNavItem) targetNavItem.click();
        });
    });
}

// Init nav on first section
renderPageNav('overview');

// ── Mobile sidebar toggle ──
document.getElementById('sidebarToggle').addEventListener('click', () => {
    sidebar.classList.toggle('open');
});

// Close sidebar on outside click (mobile)
document.addEventListener('click', (e) => {
    if (!sidebar.contains(e.target) && !e.target.closest('#sidebarToggle')) {
        sidebar.classList.remove('open');
    }
});

// ── Click-to-copy for all .copy-btn inside .cmd and pre ──
document.addEventListener('click', (e) => {
    const btn = e.target.closest('.copy-btn');
    if (!btn) return;

    // Find text: either the cmd block text or the code block
    let text = '';
    const cmdBlock = btn.closest('.cmd');
    const preBlock = btn.closest('pre');

    if (cmdBlock) {
        // Get text excluding the button text
        text = Array.from(cmdBlock.childNodes)
            .filter(n => n.nodeType === Node.TEXT_NODE)
            .map(n => n.textContent)
            .join('') + (cmdBlock.querySelector('.cmd-text')?.textContent || '');

        // Simpler approach: clone, remove btn, get text
        const clone = cmdBlock.cloneNode(true);
        clone.querySelector('.copy-btn')?.remove();
        text = clone.textContent.trim();
    } else if (preBlock) {
        text = preBlock.querySelector('code')?.textContent?.trim() || '';
    }

    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
        const orig = btn.textContent;
        btn.textContent = '✓ Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
            btn.textContent = orig;
            btn.classList.remove('copied');
        }, 1800);
    }).catch(() => {
        // Fallback
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
        btn.textContent = '✓ Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
            btn.textContent = 'Copy';
            btn.classList.remove('copied');
        }, 1800);
    });
});

// Add copy buttons to all <pre> blocks
document.querySelectorAll('pre').forEach(pre => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    pre.appendChild(btn);
});

// Initialise all declarative .pkg-tabs elements
if (window.PkgTabs) { PkgTabs.init(); }

// Add copy buttons to all <pre> blocks (skip pkg-tabs ones)
document.querySelectorAll('pre').forEach(pre => {
    if (!pre.querySelector('.copy-btn')) {
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'Copy';
        pre.appendChild(btn);
    }
});
</script>
</body>
</html>
