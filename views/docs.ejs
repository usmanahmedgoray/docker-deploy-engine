<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexaDock — Developer Documentation</title>
    <meta name="description" content="Complete developer guide for NexaDock Enterprise Container Engine. Architecture, REST API, CLI commands, subdomain proxy, networks, volumes, and more.">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Highlight.js for syntax highlighting -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
    <!-- NexaDock Package Manager Tabs Utility -->
    <script src="/pkg-tabs.js"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #08090f;
            --bg-surface: #0e1020;
            --bg-card: #111527;
            --border: rgba(255,255,255,0.07);
            --border-hl: rgba(99,102,241,0.35);
            --primary: #6366f1;
            --primary-glow: rgba(99,102,241,0.25);
            --cyan: #06b6d4;
            --emerald: #10b981;
            --amber: #f59e0b;
            --red: #ef4444;
            --text: #c4cde8;
            --text-muted: #6b7694;
            --text-bright: #f0f4ff;
            --sidebar-w: 268px;
            --topbar-h: 60px;
            --radius: 10px;
        }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.7;
            font-size: 15px;
            overflow-x: hidden;
        }

        /* ──────────────── TOPBAR ──────────────── */
        .topbar {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: var(--topbar-h);
            background: rgba(8,9,15,0.9);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            z-index: 1000;
        }

        .topbar-brand {
            display: flex; align-items: center; gap: 10px;
            text-decoration: none;
        }

        .topbar-logo {
            width: 34px; height: 34px;
            border-radius: 9px;
            background: linear-gradient(135deg, var(--primary), var(--cyan));
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 0 14px var(--primary-glow);
        }

        .topbar-name { font-weight: 800; font-size: 16px; color: #fff; }

        .topbar-badge {
            font-size: 10px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.6px; color: var(--primary);
            background: rgba(99,102,241,0.1);
            border: 1px solid rgba(99,102,241,0.2);
            padding: 2px 7px; border-radius: 4px;
        }

        .topbar-actions { display: flex; align-items: center; gap: 8px; }

        .tb-btn {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 14px;
            border-radius: 8px; font-size: 13px; font-weight: 600;
            text-decoration: none; cursor: pointer; border: none;
            font-family: 'Inter', sans-serif;
            transition: all 0.18s;
        }

        .tb-btn.ghost {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
            color: var(--text);
        }
        .tb-btn.ghost:hover { background: rgba(255,255,255,0.1); color: #fff; }

        .tb-btn.solid {
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            color: #fff;
            box-shadow: 0 4px 12px rgba(99,102,241,0.3);
        }
        .tb-btn.solid:hover { box-shadow: 0 6px 20px rgba(99,102,241,0.5); transform: translateY(-1px); }

        /* ──────────────── LAYOUT ──────────────── */
        .layout {
            display: flex;
            padding-top: var(--topbar-h);
            min-height: 100vh;
        }

        /* ──────────────── SIDEBAR ──────────────── */
        .sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            position: sticky;
            top: var(--topbar-h);
            height: calc(100vh - var(--topbar-h));
            overflow-y: auto;
            background: var(--bg-surface);
            border-right: 1px solid var(--border);
            padding: 24px 0 40px;
        }

        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }

        .nav-section { margin-bottom: 6px; }

        .nav-label {
            display: block;
            font-size: 10.5px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.8px; color: var(--text-muted);
            padding: 14px 20px 6px;
        }

        .nav-item {
            display: flex; align-items: center; gap: 9px;
            padding: 8px 20px;
            color: var(--text-muted); text-decoration: none;
            font-size: 13.5px; font-weight: 500;
            border-left: 2px solid transparent;
            transition: all 0.15s;
            cursor: pointer;
        }

        .nav-item:hover, .nav-item.active {
            color: #fff;
            border-left-color: var(--primary);
            background: rgba(99,102,241,0.07);
        }

        .nav-item svg { flex-shrink: 0; opacity: 0.7; }
        .nav-item:hover svg, .nav-item.active svg { opacity: 1; }

        /* ──────────────── CONTENT ──────────────── */
        .content {
            flex: 1; min-width: 0;
            padding: 48px 60px 80px;
            max-width: 900px;
        }

        /* ──────────────── SECTION BLOCKS ──────────────── */
        .doc-section {
            display: none;
            animation: fadeIn 0.2s ease;
        }
        .doc-section.active { display: block; }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

        /* ──────────────── TYPOGRAPHY ──────────────── */
        .section-hero {
            margin-bottom: 40px;
            padding-bottom: 32px;
            border-bottom: 1px solid var(--border);
        }

        .section-hero h1 {
            font-size: 34px; font-weight: 900; letter-spacing: -1px;
            color: var(--text-bright); margin-bottom: 12px;
            background: linear-gradient(135deg, #fff 40%, #818cf8);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .section-hero p { font-size: 16px; color: var(--text-muted); max-width: 640px; }

        h2 {
            font-size: 22px; font-weight: 800; color: var(--text-bright);
            margin: 40px 0 16px; letter-spacing: -0.4px;
            display: flex; align-items: center; gap: 10px;
        }

        h2::before {
            content: '';
            display: block; width: 3px; height: 22px;
            background: linear-gradient(180deg, var(--primary), var(--cyan));
            border-radius: 2px; flex-shrink: 0;
        }

        h3 {
            font-size: 16px; font-weight: 700; color: var(--text-bright);
            margin: 28px 0 12px;
        }

        p { color: var(--text); line-height: 1.75; margin-bottom: 16px; }

        a { color: var(--primary); text-decoration: none; }
        a:hover { color: #818cf8; text-decoration: underline; }

        code {
            font-family: 'Fira Code', monospace;
            font-size: 13px; background: rgba(99,102,241,0.1);
            color: #a5b4fc; padding: 2px 7px; border-radius: 5px;
        }

        /* ──────────────── CMD / CODE BLOCKS ──────────────── */
        .cmd {
            position: relative;
            background: #0b0e1c;
            border: 1px solid var(--border);
            border-left: 3px solid var(--cyan);
            border-radius: var(--radius);
            padding: 14px 52px 14px 18px;
            margin: 14px 0;
            font-family: 'Fira Code', monospace;
            font-size: 13.5px;
            color: #67e8f9;
            overflow-x: auto;
            white-space: pre;
        }

        .cmd .copy-btn {
            position: absolute;
            top: 8px; right: 8px;
            background: rgba(99,102,241,0.12);
            border: 1px solid rgba(99,102,241,0.25);
            color: #a5b4fc; padding: 4px 10px;
            border-radius: 6px; font-size: 11.5px; font-weight: 600;
            cursor: pointer; font-family: 'Inter', sans-serif;
            transition: all 0.18s; white-space: nowrap;
        }

        .cmd .copy-btn:hover { background: var(--primary); color: #fff; }
        .cmd .copy-btn.copied { background: rgba(16,185,129,0.15); border-color: rgba(16,185,129,0.3); color: #34d399; }

        /* Highlight.js overrides */
        pre code.hljs {
            background: #0b0e1c !important;
            border-radius: var(--radius);
            font-size: 13px;
            font-family: 'Fira Code', monospace;
            padding: 18px 20px;
        }

        pre {
            position: relative;
            margin: 14px 0;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
        }

        pre .copy-btn {
            position: absolute;
            top: 8px; right: 8px;
            background: rgba(99,102,241,0.12);
            border: 1px solid rgba(99,102,241,0.25);
            color: #a5b4fc; padding: 4px 10px;
            border-radius: 6px; font-size: 11.5px; font-weight: 600;
            cursor: pointer; font-family: 'Inter', sans-serif;
            transition: all 0.18s;
        }

        pre .copy-btn:hover { background: var(--primary); color: #fff; }
        pre .copy-btn.copied { background: rgba(16,185,129,0.15); border-color: rgba(16,185,129,0.3); color: #34d399; }

        /* ──────────────── CALLOUTS ──────────────── */
        .callout {
            display: flex; gap: 12px;
            padding: 14px 18px;
            border-radius: var(--radius);
            margin: 18px 0;
            font-size: 14px; line-height: 1.6;
        }
        .callout-icon { flex-shrink: 0; margin-top: 1px; font-size: 16px; }
        .callout p { margin: 0; }

        .callout.info { background: rgba(99,102,241,0.08); border-left: 3px solid var(--primary); color: #a5b4fc; }
        .callout.warning { background: rgba(245,158,11,0.08); border-left: 3px solid var(--amber); color: #fde68a; }
        .callout.success { background: rgba(16,185,129,0.08); border-left: 3px solid var(--emerald); color: #6ee7b7; }
        .callout.danger { background: rgba(239,68,68,0.08); border-left: 3px solid var(--red); color: #fca5a5; }

        /* ──────────────── TABLES ──────────────── */
        table {
            width: 100%; border-collapse: collapse;
            margin: 20px 0; font-size: 14px;
        }
        th, td { padding: 11px 16px; border: 1px solid var(--border); text-align: left; }
        th { background: rgba(255,255,255,0.03); color: var(--text-bright); font-weight: 700; }
        tr:nth-child(even) td { background: rgba(255,255,255,0.02); }
        td code { font-size: 12px; }

        /* ──────────────── ARCH DIAGRAM ──────────────── */
        .arch-box {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 28px 20px;
            margin: 24px 0;
            overflow-x: auto;
            text-align: center;
        }

        /* ──────────────── FEATURE GRID ──────────────── */
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px; margin: 24px 0;
        }

        .feature-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 20px;
            transition: all 0.2s;
        }
        .feature-card:hover { border-color: var(--border-hl); transform: translateY(-2px); }

        .fc-icon {
            width: 40px; height: 40px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 14px; font-size: 20px;
        }

        .fc-icon.purple { background: rgba(99,102,241,0.12); }
        .fc-icon.cyan { background: rgba(6,182,212,0.12); }
        .fc-icon.emerald { background: rgba(16,185,129,0.12); }
        .fc-icon.amber { background: rgba(245,158,11,0.12); }

        .feature-card h4 { font-size: 15px; font-weight: 700; color: var(--text-bright); margin-bottom: 8px; }
        .feature-card p { font-size: 13.5px; color: var(--text-muted); line-height: 1.6; margin: 0; }

        /* ──────────────── BADGE / TAG ──────────────── */
        .badge {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 3px 9px; border-radius: 20px; font-size: 12px; font-weight: 600;
        }
        .badge.green { background: rgba(16,185,129,0.12); color: #34d399; border: 1px solid rgba(16,185,129,0.2); }
        .badge.blue { background: rgba(99,102,241,0.12); color: #a5b4fc; border: 1px solid rgba(99,102,241,0.2); }
        .badge.amber { background: rgba(245,158,11,0.12); color: #fbbf24; border: 1px solid rgba(245,158,11,0.2); }
        .badge.red { background: rgba(239,68,68,0.12); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }

        /* ──────────────── DIVIDER ──────────────── */
        hr { border: none; border-top: 1px solid var(--border); margin: 36px 0; }

        /* ──────────────── MOBILE ──────────────── */
        .mobile-sidebar-toggle {
            display: none;
            align-items: center; justify-content: center;
            width: 36px; height: 36px; border-radius: 8px;
            background: rgba(255,255,255,0.05); border: 1px solid var(--border);
            color: var(--text); cursor: pointer;
        }

        @media (max-width: 900px) {
            .content { padding: 32px 24px 60px; }
        }

        @media (max-width: 768px) {
            .sidebar { position: fixed; left: -100%; top: var(--topbar-h); height: calc(100vh - var(--topbar-h)); z-index: 500; transition: left 0.25s; }
            .sidebar.open { left: 0; }
            .mobile-sidebar-toggle { display: flex; }
            .topbar-actions .tb-btn span { display: none; }
            .content { padding: 24px 18px 60px; }
        }
        /* ──────────────── PAGE NAV FOOTER ──────────────── */
        .page-nav-footer {
            display: flex;
            gap: 16px;
            margin-top: 56px;
            padding-top: 32px;
            border-top: 1px solid var(--border);
        }

        .page-nav-card {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 18px 20px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
            overflow: hidden;
        }

        .page-nav-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(99,102,241,0.05), rgba(6,182,212,0.05));
            opacity: 0;
            transition: opacity 0.2s;
        }

        .page-nav-card:hover {
            border-color: var(--border-hl);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.3);
        }

        .page-nav-card:hover::before { opacity: 1; }

        .page-nav-card.prev { justify-content: flex-start; }
        .page-nav-card.next { justify-content: flex-end; text-align: right; }
        .page-nav-card.next .page-nav-text { align-items: flex-end; }

        .page-nav-arrow {
            width: 36px; height: 36px; border-radius: 9px;
            background: rgba(99,102,241,0.1);
            border: 1px solid rgba(99,102,241,0.2);
            display: flex; align-items: center; justify-content: center;
            color: #818cf8; flex-shrink: 0;
            transition: all 0.2s;
        }

        .page-nav-card:hover .page-nav-arrow {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        .page-nav-text {
            display: flex; flex-direction: column; gap: 3px;
        }

        .page-nav-label {
            font-size: 10.5px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.6px; color: var(--text-muted);
        }

        .page-nav-name {
            font-size: 14px; font-weight: 700; color: var(--text-bright);
            display: flex; align-items: center; gap: 6px;
        }

        .page-nav-spacer { flex: 1; }

        /* ──────────────── STEP LIST ──────────────── */
        .step-list { margin: 20px 0; display: flex; flex-direction: column; gap: 0; }

        .step-item {
            display: flex; gap: 16px;
            padding: 16px 0;
            border-bottom: 1px solid var(--border);
        }
        .step-item:last-child { border-bottom: none; }

        .step-num {
            width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
            background: rgba(99,102,241,0.12);
            border: 1px solid rgba(99,102,241,0.25);
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 800; color: #818cf8;
            margin-top: 2px;
        }

        .step-body h4 { font-size: 14.5px; font-weight: 700; color: var(--text-bright); margin-bottom: 5px; }
        .step-body p { font-size: 13.5px; color: var(--text-muted); margin: 0; line-height: 1.6; }
        .step-body code { font-size: 12px; }

        /* ──────────────── COMPARISON TABLE ──────────────── */
        .compare-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px; margin: 20px 0;
        }

        .compare-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 18px;
        }

        .compare-card h4 {
            font-size: 13px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.5px; margin-bottom: 12px;
        }

        .compare-card.do { border-top: 2px solid var(--emerald); }
        .compare-card.do h4 { color: var(--emerald); }
        .compare-card.dont { border-top: 2px solid var(--red); }
        .compare-card.dont h4 { color: var(--red); }

        .compare-card ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
        .compare-card ul li { font-size: 13.5px; color: var(--text-muted); display: flex; gap: 8px; align-items: flex-start; }
        .compare-card.do ul li::before { content: '✓'; color: var(--emerald); font-weight: 700; flex-shrink: 0; }
        .compare-card.dont ul li::before { content: '✗'; color: var(--red); font-weight: 700; flex-shrink: 0; }

        @media (max-width: 600px) {
            .compare-grid { grid-template-columns: 1fr; }
            .page-nav-footer { flex-direction: column; }
        }
    </style>
</head>
<body>

<!-- ═══════════ TOPBAR ═══════════ -->
<header class="topbar">
    <div style="display:flex;align-items:center;gap:12px;">
        <button class="mobile-sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <a href="/" class="topbar-brand">
            <div class="topbar-logo">
                <svg viewBox="0 0 64 64" width="20" height="20">
                    <path d="M32 10 L50 20 V42 L32 52 L14 42 V20 Z" fill="none" stroke="#fff" stroke-width="3.5" stroke-linejoin="round"/>
                    <circle cx="32" cy="32" r="4.5" fill="#06b6d4"/>
                </svg>
            </div>
            <span class="topbar-name">NexaDock</span>
            <span class="topbar-badge">Docs</span>
        </a>
    </div>
    <div class="topbar-actions">
        <a href="/api-docs" target="_blank" class="tb-btn ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span>Swagger UI</span>
        </a>
        <a href="/app" class="tb-btn solid">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>Open Console</span>
        </a>
    </div>
</header>

<!-- ═══════════ LAYOUT ═══════════ -->
<div class="layout">

    <!-- ─── SIDEBAR ─── -->
    <aside class="sidebar" id="sidebar">
        <div class="nav-section">
            <span class="nav-label">Getting Started</span>
            <a class="nav-item active" data-section="overview">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                Overview
            </a>
            <a class="nav-item" data-section="quickstart">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                Quick Start
            </a>
            <a class="nav-item" data-section="architecture">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="6" height="6"/><rect x="9" y="3" width="6" height="6"/><rect x="16" y="3" width="6" height="6"/><line x1="5" y1="9" x2="5" y2="18"/><line x1="12" y1="9" x2="12" y2="18"/><line x1="5" y1="18" x2="19" y2="18"/><line x1="19" y1="9" x2="19" y2="18"/></svg>
                Architecture
            </a>
        </div>

        <div class="nav-section">
            <span class="nav-label">Core Features</span>
            <a class="nav-item" data-section="containers">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/></svg>
                Containers
