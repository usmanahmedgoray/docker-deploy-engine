<%- include('partials/header') %>

        <!-- Main Views Container -->
        <main class="main-content">
            
            <!-- VIEW 0: OVERVIEW DASHBOARD -->
            <section id="viewOverview" class="view-panel active">
                <div class="stats-grid" id="overviewStatsGrid">
                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Running Containers</span>
                            <h2 class="stat-value" id="ovRunningCount">0 <span style="font-size:14px;color:var(--text-dim);font-weight:600;">/ 0</span></h2>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon cyan">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Avg CPU Usage</span>
                            <h2 class="stat-value" id="ovCpuPercent">0%</h2>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon emerald">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 19V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v14"/><path d="M2 19h20"/><path d="M9 3v4M15 3v4"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Memory Usage</span>
                            <h2 class="stat-value" id="ovMemUsage">0 MB</h2>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon amber">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="12" x2="2" y2="12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Cached Images</span>
                            <h2 class="stat-value" id="ovImagesCount">0</h2>
                        </div>
                    </div>
                </div>

                <div class="section-header">
                    <div>
                        <h2>Resource Usage</h2>
                        <p class="subtitle">Live CPU and memory consumption across the fleet</p>
                    </div>
                    <button class="btn btn-secondary" id="refreshOverviewBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                        <span>Refresh</span>
                    </button>
                </div>

                <div class="overview-charts-grid">
                    <div class="chart-card">
                        <h3>CPU Utilization</h3>
                        <p class="subtitle">Average across all running containers</p>
                        <div class="gauge-wrap">
                            <svg class="gauge-svg" viewBox="0 0 140 140">
                                <circle class="gauge-track" cx="70" cy="70" r="58"></circle>
                                <circle class="gauge-value" id="cpuGaugeArc" cx="70" cy="70" r="58"></circle>
                            </svg>
                            <div class="gauge-center">
                                <span class="gauge-num" id="cpuGaugeText">0%</span>
                                <span class="gauge-lbl">avg / core</span>
                            </div>
                        </div>
                    </div>

                    <div class="chart-card">
                        <h3>Memory Utilization</h3>
                        <p class="subtitle" id="memSubtitle">0 MB of 0 GB allocated</p>
                        <div class="mem-bar-track"><div class="mem-bar-fill" id="memBarFill" style="width:0%"></div></div>

                        <div class="resource-bar-list" id="topContainersList">
                            <p class="subtitle" style="text-align:center;padding:12px 0;">No running containers to measure.</p>
                        </div>
                    </div>
                </div>

                <div class="section-header">
                    <div>
                        <h2>Recent Containers</h2>
                        <p class="subtitle">Latest deployed containers on the engine</p>
                    </div>
                    <button class="btn btn-secondary btn-sm" id="viewAllContainersBtn">
                        <span>View All Containers</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                </div>

                <div class="container-grid" id="recentContainersGrid">
                    <!-- Latest 3 containers rendered dynamically -->
                </div>

                <div class="section-header">
                    <div>
                        <h2>Recent Images</h2>
                        <p class="subtitle">Latest cached image layers on the host</p>
                    </div>
                    <button class="btn btn-secondary btn-sm" id="viewAllImagesBtn">
                        <span>View All Images</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                </div>

                <div class="container-grid" id="recentImagesGrid">
                    <!-- Latest 3 images rendered dynamically -->
                </div>
            </section>

            <!-- VIEW 1: CONTAINERS DASHBOARD -->
            <section id="viewContainers" class="view-panel hidden">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Active Containers</span>
                            <h2 class="stat-value" id="statRunningCount">0</h2>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon cyan">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Subdomain Router</span>
                            <h2 class="stat-value" id="statDomain"><%= config.domain %>:<%= config.port %></h2>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon emerald">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Bridge Network</span>
                            <h2 class="stat-value"><%= config.dockerNetwork %></h2>
                        </div>
                    </div>
                </div>

                <div class="section-header">
                    <div>
                        <h2>Managed Containers</h2>
                        <p class="subtitle">Live container lifecycle control, status badges, and subdomain URLs</p>
                    </div>
                    <button class="btn btn-secondary" id="refreshContainersBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                        <span>Refresh</span>
                    </button>
                </div>

                <div class="container-grid" id="containerGrid">
                    <!-- Containers rendered dynamically with Skeleton loader -->
                </div>
            </section>

            <!-- VIEW 2: DOCKER IMAGES -->
            <section id="viewImages" class="view-panel hidden">
                <div class="section-header">
                    <div>
                        <h2>Local Docker Images</h2>
                        <p class="subtitle">Cached image layers and repository tags on host machine</p>
                    </div>
                    <button class="btn btn-secondary" id="refreshImagesBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                        <span>Refresh Images</span>
                    </button>
                </div>

                <div class="table-card">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Repository / Tag</th>
                                <th>Image ID</th>
                                <th>Size</th>
                                <th>Created</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="imagesTableBody">
                            <!-- Images rendered dynamically -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- VIEW 3: NETWORKS -->
            <section id="viewNetworks" class="view-panel hidden">
                <div class="section-header">
                    <div>
                        <h2>Docker Networks</h2>
                        <p class="subtitle">Network drivers, scopes, subnets, and connected endpoints</p>
                    </div>
                    <button class="btn btn-secondary" id="refreshNetworksBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                        <span>Refresh Networks</span>
                    </button>
                </div>

                <div class="table-card">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Network Name</th>
                                <th>ID</th>
                                <th>Driver</th>
                                <th>Subnet / Gateway</th>
                                <th>Scope</th>
                                <th>Attached Containers</th>
                            </tr>
                        </thead>
                        <tbody id="networksTableBody">
                            <!-- Networks rendered dynamically -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- VIEW 4: VOLUMES -->
            <section id="viewVolumes" class="view-panel hidden">
                <div class="section-header">
                    <div>
                        <h2>Docker Volumes</h2>
                        <p class="subtitle">Persistent volume mounts and host storage paths</p>
                    </div>
                    <button class="btn btn-secondary" id="refreshVolumesBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                        <span>Refresh Volumes</span>
                    </button>
                </div>

                <div class="table-card">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Volume Name</th>
                                <th>Driver</th>
                                <th>Mountpoint</th>
                                <th>Scope</th>
                            </tr>
                        </thead>
                        <tbody id="volumesTableBody">
                            <!-- Volumes rendered dynamically -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- VIEW 5: METRICS & INTERNAL IP LIST -->
            <section id="viewMetrics" class="view-panel hidden">
                <div class="section-header">
                    <div>
                        <h2>Engine Metrics & Network Allocation</h2>
                        <p class="subtitle">Internal IP assignments and reverse proxy routing table</p>
                    </div>
                </div>

                <div class="table-card">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Container Name</th>
                                <th>Internal IP (<%= config.dockerNetwork %>)</th>
                                <th>Status</th>
                                <th>Proxy URL</th>
                            </tr>
                        </thead>
                        <tbody id="metricsTableBody">
                            <!-- Metrics IP rows -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- VIEW 6: SYSTEM CONFIG & ENV -->
            <section id="viewConfig" class="view-panel hidden">
                <div class="section-header">
                    <div>
                        <h2>Environment & System Configuration</h2>
                        <p class="subtitle">Loaded environment variables and runtime settings</p>
                    </div>
                </div>

                <div class="config-grid">
                    <div class="config-card">
                        <h3>Active Environment (.env)</h3>
                        <div class="config-list" id="configList">
                            <div class="config-item"><span>PORT (Public Entrypoint):</span> <strong><%= config.port %></strong></div>
                            <div class="config-item"><span>MANAGEMENT_PORT (Internal API):</span> <strong><%= config.managementPort %></strong></div>
                            <div class="config-item"><span>MANAGEMENT_HOST:</span> <strong><%= config.managementHost %></strong></div>
                            <div class="config-item"><span>DOMAIN (Base Domain):</span> <strong><%= config.domain %></strong></div>
                            <div class="config-item"><span>DOCKER_NETWORK:</span> <strong><%= config.dockerNetwork %></strong></div>
                            <div class="config-item"><span>NODE_ENV:</span> <strong>production</strong></div>
                        </div>
                    </div>
                </div>
            </section>

        </main>
    </div>

<%- include('partials/modals') %>

    <!-- Toast Notifications -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="/app.js"></script>
</body>
</html>
