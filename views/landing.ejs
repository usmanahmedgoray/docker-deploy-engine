    <script>
        (function () {
            // Gentle scroll-reveal for section headers, feature cards, and CTA bands
            var revealEls = document.querySelectorAll('.reveal');
            if ('IntersectionObserver' in window && revealEls.length) {
                var revealObs = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('in-view');
                            revealObs.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.15 });
                revealEls.forEach(function (el) { revealObs.observe(el); });
            } else {
                revealEls.forEach(function (el) { el.classList.add('in-view'); });
            }

            // Sticky feature narrative — swap active step / visual panel / dot on scroll
            var steps = document.querySelectorAll('.lp-step');
            var panels = document.querySelectorAll('.lp-visual-panel');
            var dots = document.querySelectorAll('.lp-visual-dot');

            if ('IntersectionObserver' in window && steps.length && window.matchMedia('(min-width: 993px)').matches) {
                var stickyObs = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            var i = entry.target.getAttribute('data-step');
                            steps.forEach(function (s) { s.classList.toggle('active', s === entry.target); });
                            panels.forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-panel') === i); });
                            dots.forEach(function (d) { d.classList.toggle('active', d.getAttribute('data-dot') === i); });
                        }
                    });
                }, { threshold: 0, rootMargin: '-50% 0px -50% 0px' });
                steps.forEach(function (s) { stickyObs.observe(s); });
            }
        })();
    </script>
